# Formal Verification Docker Image — Verus Prover (pinned release)
# Used by `make formal-verus-docker` for CI environments where
# native Verus is unavailable.
#
# PINNED: Uses pre-built binary from a specific release to prevent breakage
# when Verus HEAD introduces breaking API changes (a common occurrence).
# To upgrade: update VERUS_VERSION to the new release tag and test locally.

FROM debian:bookworm-slim

# Runtime deps: curl + unzip to fetch the pre-built binary, z3 for fallback SMT
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    z3 \
    ca-certificates \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Verus >= 0.2026.02.15 requires rustup at runtime (it invokes rustc internally).
# Install rustup with the specific toolchain Verus expects.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.93.0-x86_64-unknown-linux-gnu --profile minimal \
    && rustup --version && rustc --version

# Pin Verus to a specific known-working release.
# See https://github.com/verus-lang/verus/releases for available tags.
ENV VERUS_VERSION=0.2026.02.15.61aa1bf

# Download the pre-built x86 Linux binary (much faster and more reliable than
# building from source, which requires a specific Rust nightly and can break
# whenever Verus HEAD changes its internal API).
RUN curl -fsSL -o /tmp/verus.zip \
      "https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/verus-${VERUS_VERSION}-x86-linux.zip" \
    && unzip -q /tmp/verus.zip -d /opt/verus-dist \
    && rm /tmp/verus.zip \
    # The ZIP may unpack into a subdirectory; find the verus binary
    && VERUS_BIN=$(find /opt/verus-dist -name 'verus' -type f | head -1) \
    && if [ -z "$VERUS_BIN" ]; then echo "ERROR: verus binary not found in ZIP" && exit 1; fi \
    && cp "$(dirname $VERUS_BIN)/"* /usr/local/bin/ 2>/dev/null || true \
    && chmod +x /usr/local/bin/verus \
    && verus --version

WORKDIR /crypto_core

# Copy only the Rust crypto_core crate
COPY crypto_core/ /crypto_core/
COPY Cargo.toml /Cargo.toml

# Verify the crypto_core Verus annotations.
# --crate-type lib: tell Verus we're verifying a library, not a binary.
# If Verus exits non-zero the Docker run step will fail and the CI step fails.
CMD ["verus", "--crate-type", "lib", "src/lib.rs"]
