# Formal Verification Docker Image — Verus Prover (nightly)
# Used by `make formal-verus-docker` for CI environments where
# native Verus is unavailable (e.g., Alpine Linux / musl libc).
#
# Verus requires a specific nightly Rust toolchain and only runs on glibc.

FROM rust:1.82-bookworm

# Install Verus dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    z3 \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install Verus from source
# Note: vargo build may produce warnings on stderr; we redirect stderr to a log
# but still fail on actual build errors (exit code check).
RUN git clone --depth 1 https://github.com/verus-lang/verus.git /opt/verus \
    && cd /opt/verus/source \
    && ./tools/get-z3.sh \
    && . ./tools/activate \
    && vargo build --release 2>/tmp/verus_build.log \
    && test -f /opt/verus/source/target-verus/release/verus \
    || { echo "Verus build failed — see /tmp/verus_build.log"; cat /tmp/verus_build.log; exit 1; }

ENV PATH="/opt/verus/source/target-verus/release:${PATH}"

WORKDIR /crypto_core

# Copy only the Rust crypto_core crate
COPY crypto_core/ /crypto_core/
COPY Cargo.toml /Cargo.toml

# Default: verify the crypto_core proofs
CMD ["verus", "src/lib.rs"]
