# Verus Structural Regression Tracker (NOT Z3 Verification)
# Used by `make formal-verus-docker` for CI environments.
#
# ⚠️ THIS DOES NOT INVOKE THE VERUS/Z3 TOOLCHAIN.
# It counts proof fn / spec fn declarations to detect regressions
# (e.g., accidental deletion of proof blocks).
#
# Full Z3/Verus verification must be run locally:
#   cargo install verus && cd crypto_core && verus src/aead_wrapper.rs
# See ARCHITECTURE.md for setup instructions.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /crypto_core

COPY crypto_core/ /crypto_core/
COPY Cargo.toml /Cargo.toml

CMD ["sh", "-c", "\
    echo '=== Verus Structural Regression Check ===' && \
    echo '⚠️  This is a STRUCTURAL check only — counts proof fn / spec fn declarations.' && \
    echo '    It does NOT invoke Z3/Verus. Properties are NOT machine-checked here.' && \
    echo '' && \
    echo 'Checking aead_wrapper.rs...' && \
    PROOF_COUNT=$(grep -c 'proof fn' src/aead_wrapper.rs 2>/dev/null || echo 0) && \
    echo \"  proof fn count: $PROOF_COUNT\" && \
    echo '' && \
    echo 'Checking verus_guarded_buffer.rs...' && \
    GB_COUNT=$(grep -c 'proof fn\\|spec fn' src/verus_guarded_buffer.rs 2>/dev/null || echo 0) && \
    echo \"  proof/spec fn count: $GB_COUNT\" && \
    echo '' && \
    echo 'Checking verus_kdf_proofs.rs...' && \
    KDF_COUNT=$(grep -c 'proof fn\\|spec fn' src/verus_kdf_proofs.rs 2>/dev/null || echo 0) && \
    echo \"  proof/spec fn count: $KDF_COUNT\" && \
    echo '' && \
    echo 'Checking verus_windows_guard.rs...' && \
    WG_COUNT=$(grep -c 'proof fn\\|spec fn' src/verus_windows_guard.rs 2>/dev/null || echo 0) && \
    echo \"  proof/spec fn count: $WG_COUNT\" && \
    echo '' && \
    echo 'Checking verus_proofs.rs (runtime checks — no verus blocks expected)...' && \
    VP_COUNT=$(grep -c 'verus!' src/verus_proofs.rs 2>/dev/null || echo 0) && \
    echo \"  verus! blocks: $VP_COUNT (expected 0 — runtime-only module)\" && \
    echo '' && \
    TOTAL=$((PROOF_COUNT + GB_COUNT + KDF_COUNT + WG_COUNT)) && \
    echo \"structural inventory:: proof_spec_fn_count: $TOTAL\" && \
    echo '' && \
    if [ \"$TOTAL\" -lt 1 ]; then \
      echo '❌ REGRESSION: No proof/spec fn declarations found. Were Verus blocks deleted?' && \
      exit 1; \
    fi && \
    echo \"✅ Structural regression check passed ($TOTAL proof/spec fn declarations present)\" && \
    echo '' && \
    echo 'NOTE: These declarations are NOT Z3-verified in CI.' && \
    echo 'Run verus locally to machine-check properties. See ARCHITECTURE.md.' \
    "]
