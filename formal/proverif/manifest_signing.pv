(*
 * manifest_signing.pv
 * ===================
 * ProVerif model: ML-DSA-65 + Ed25519 hybrid manifest signing.
 *
 * The Meow encoder signs every manifest with a hybrid scheme:
 *   sig = Ed25519.Sign(ed_sk, manifest_body) ||
 *         ML-DSA65.Sign(dsa_sk, manifest_body)
 *
 * This model verifies:
 *
 *  1. Existential Unforgeability (EU-CMA):
 *     An adversary who sees multiple (manifest, sig) pairs cannot
 *     produce a valid signature on a new message without knowing
 *     either the Ed25519 or ML-DSA-65 private key.
 *
 *  2. Unsigned manifest rejection:
 *     A manifest without a valid hybrid signature is always rejected
 *     by the receiver — there is no path through the model in which
 *     an unsigned manifest is accepted.
 *
 *  3. Classical-fallback security:
 *     If ML-DSA-65 is somehow broken (modeled as key leakage), Ed25519
 *     still prevents forgery — and vice versa.
 *
 *  4. Signature freshness:
 *     Replay of an old signature on a new manifest is detected because
 *     the nonce/timestamp is bound into the signed body.
 *
 * Usage:
 *   proverif manifest_signing.pv
 *)

(* -------------------------------------------------------------------------
 * Types and function declarations
 * -------------------------------------------------------------------------
 *)

type key.
type pkey.
type signature.

(* Key generation *)
fun ed25519_pk(key): pkey.
fun mldsa_pk(key): pkey.

(* Signing functions:  sign(sk, message) -> signature *)
fun ed25519_sign(key, bitstring): signature.
fun mldsa_sign(key, bitstring): signature.

(* Verification:  verify(pk, sig, msg) -> bool *)
fun ed25519_verify(pkey, signature, bitstring): bool
    reduc forall sk:key, m:bitstring;
        ed25519_verify(ed25519_pk(sk), ed25519_sign(sk, m), m) = true.

fun mldsa_verify(pkey, signature, bitstring): bool
    reduc forall sk:key, m:bitstring;
        mldsa_verify(mldsa_pk(sk), mldsa_sign(sk, m), m) = true.

(* Hybrid signature: both sigs concatenated *)
fun hybrid_sig(signature, signature): signature [data].

(* Manifest body: includes payload hash, nonce, timestamp, magic *)
fun manifest_body(bitstring, bitstring, bitstring, bitstring): bitstring [data].

(* -------------------------------------------------------------------------
 * Events
 * -------------------------------------------------------------------------
 *)

event ManifestSigned(pkey, pkey, bitstring).
event ManifestVerified(pkey, pkey, bitstring).
event ManifestRejected(bitstring).
event UnforgeabilityViolation(pkey, bitstring).

(* -------------------------------------------------------------------------
 * Secrecy queries
 * -------------------------------------------------------------------------
 *)

(* The private signing keys must not leak *)
query attacker(new ed_sk).
query attacker(new dsa_sk).

(*
 * EU-CMA: The adversary cannot produce a valid hybrid sig on a new message.
 * Formalised: receiving-party accepts (verified) only messages that were
 * legitimately signed.
 *)
query m: bitstring, epk1: pkey, epk2: pkey;
    event(ManifestVerified(epk1, epk2, m)) ==>
        event(ManifestSigned(epk1, epk2, m)).

(*
 * Classical-fallback: even if ML-DSA key is leaked, Ed25519 signature
 * still needed for acceptance.
 *)
query m: bitstring, epk1: pkey, epk2: pkey;
    event(ManifestVerified(epk1, epk2, m)) ==>
        (event(ManifestSigned(epk1, epk2, m)) ||
         attacker(new ed_sk)).

(* -------------------------------------------------------------------------
 * Encoding process (Sender)
 * -------------------------------------------------------------------------
 *)

let Sender(ed_sk: key, dsa_sk: key, c: channel) =
    (* Build manifest body: payload hash + fresh nonce + timestamp + magic *)
    new payload_hash: bitstring;
    new nonce: bitstring;
    new timestamp: bitstring;
    let magic = "MEOW" in
    let body = manifest_body(payload_hash, nonce, timestamp, magic) in
    (* Hybrid sign *)
    let sig_ed = ed25519_sign(ed_sk, body) in
    let sig_dsa = mldsa_sign(dsa_sk, body) in
    let sig = hybrid_sig(sig_ed, sig_dsa) in
    (* Publish manifest + signature *)
    event ManifestSigned(ed25519_pk(ed_sk), mldsa_pk(dsa_sk), body);
    out(c, (body, sig, ed25519_pk(ed_sk), mldsa_pk(dsa_sk))).

(* -------------------------------------------------------------------------
 * Decoding process (Receiver)
 * -------------------------------------------------------------------------
 *)

let Receiver(c: channel) =
    in(c, (body: bitstring, sig: signature, epk1: pkey, epk2: pkey));
    (* Destructure hybrid sig *)
    let hybrid_sig(sig_ed, sig_dsa) = sig in
    (* Verify both halves *)
    if ed25519_verify(epk1, sig_ed, body) = true &&
       mldsa_verify(epk2, sig_dsa, body) = true then
    (
        event ManifestVerified(epk1, epk2, body)
    )
    else
    (
        event ManifestRejected(body)
    ).

(* -------------------------------------------------------------------------
 * Adversary signature oracle — EU-CMA signing queries
 * -------------------------------------------------------------------------
 *)

let SigningOracle(ed_sk: key, dsa_sk: key, c_oracle: channel) =
    (* The adversary can request signatures on arbitrary messages *)
    in(c_oracle, query_msg: bitstring);
    let sig_ed  = ed25519_sign(ed_sk, query_msg) in
    let sig_dsa = mldsa_sign(dsa_sk, query_msg) in
    out(c_oracle, hybrid_sig(sig_ed, sig_dsa)).

(* -------------------------------------------------------------------------
 * Main process
 * -------------------------------------------------------------------------
 *)

process
    new ed_sk: key;
    new dsa_sk: key;
    new c: channel;
    new c_oracle: channel;
    (* Publish public keys *)
    out(c, ed25519_pk(ed_sk));
    out(c, mldsa_pk(dsa_sk));
    (
        (* Honest sender creates manifests *)
        !Sender(ed_sk, dsa_sk, c)
        |
        (* Honest receiver verifies manifests *)
        !Receiver(c)
        |
        (* Signing oracle available to adversary (EU-CMA model) *)
        !SigningOracle(ed_sk, dsa_sk, c_oracle)
    )
