/*
 * MeowRatchetHeaderOE.spthy
 * =========================
 * Tamarin model: Ratchet header encryption observational equivalence.
 *
 * The MSR v1.2 ratchet encrypts frame indices to prevent a passive observer
 * from learning sequencing information.  This model verifies:
 *
 *  1. Header Indistinguishability (OE):
 *     An adversary observing the encrypted wire format cannot distinguish
 *     which frame index appears in a given frame.
 *
 *  2. Header Authentication:
 *     A forged or replayed header (wrong encrypted index) is always
 *     rejected by the receiver -- the header mask is bound to the chain key.
 *
 * Header encryption:
 *   header_key = HKDF(root_key, salt, "header")
 *   enc_idx    = idx XOR HKDF(header_key, idx_nonce, "mask")[0..3]
 *
 * Run with:
 *   tamarin-prover MeowRatchetHeaderOE.spthy --prove
 */

theory MeowRatchetHeaderOE
begin

builtins: diffie-hellman, hashing, symmetric-encryption

functions:
  hkdf/3,
  xor_mask/2,   /* xor_mask(key, idx) = HKDF(key, idx, "mask")[0..3] XOR idx */
  unmask/2

equations:
  unmask(k, xor_mask(k, idx)) = idx

/* -------------------------------------------------------------------------
 * Header Key Derivation
 * -------------------------------------------------------------------------
 */

rule InitHeaderKeys:
  [ Fr(~root_key), Fr(~salt) ]
  --[ InitHeader(~root_key) ]->
  [ !HeaderKey($Sender, hkdf(~root_key, ~salt, 'header'), ~root_key) ]

/* Sender emits a frame with encrypted index */
rule SendFrame:
  let hk      = hkdf(root_key, salt, 'header')
      enc_idx = xor_mask(hk, idx)
  in
  [ !HeaderKey($Sender, hk, root_key),
    Fr(~idx), Fr(~payload) ]
  --[ SentFrameWithIdx($Sender, ~idx, enc_idx, ~payload) ]->
  [ Out(<enc_idx, ~payload>) ]

/* Receiver decrypts header */
rule RecvFrame:
  let hk  = hkdf(root_key, salt, 'header')
      idx = unmask(hk, enc_idx)
  in
  [ !HeaderKey($Receiver, hk, root_key),
    In(<enc_idx, pl>) ]
  --[ ReceivedFrameWithIdx($Receiver, idx, enc_idx, pl) ]->
  []

/* Adversary cannot forge a valid encrypted index without the header key */
rule AdversaryForgeHeader:
  [ In(enc_idx_known),
    Fr(~fake_payload) ]
  --[ AdversaryForgedHeader(enc_idx_known) ]->
  [ Out(<enc_idx_known, ~fake_payload>) ]

/* =========================================================================
 * Security Lemmas
 * =========================================================================
 */

/*
 * LEMMA 1 -- Header Indistinguishability
 *
 * An adversary who does not know the header key cannot determine the
 * plaintext frame index from the encrypted header.  Formalised as:
 * if an adversary knows enc_idx, they cannot learn idx without hk.
 */
lemma HeaderIndistinguishability:
  "All sender idx enc_idx payload hk #t .
    SentFrameWithIdx(sender, idx, enc_idx, payload) @ #t
    ==>
    /* Adversary cannot learn idx from enc_idx without the header key */
    (not (Ex #t2 . KU(idx) @ #t2)) |
    (Ex #t3 . KU(hk) @ #t3)
  "

/*
 * LEMMA 2 -- Header Authentication
 *
 * A forged header (one not produced by a legitimate ratchet step) will
 * be rejected by the receiver because it cannot produce a valid unmask.
 * Formalised: every received frame with a valid idx came from a legitimate
 * sender (i.e., no forged header can be accepted).
 */
lemma HeaderAuthentication:
  "All receiver idx enc_idx pl #t .
    ReceivedFrameWithIdx(receiver, idx, enc_idx, pl) @ #t
    ==>
    /* Either a legitimate sender sent this frame ... */
    (Ex sender payload #t2 .
      SentFrameWithIdx(sender, idx, enc_idx, payload) @ #t2 & #t2 < #t
    ) |
    /* ... or the adversary knows the header key (and can forge) */
    (Ex hk #t3 . KU(hk) @ #t3)
  "

/*
 * LEMMA 3 -- Replay Rejection
 *
 * Replaying an old encrypted header with an increased expected frame count
 * must fail -- the receiver cannot unmask the replayed index to match the
 * expected next frame.
 */
lemma ReplayRejection:
  "All sender receiver idx enc_idx1 enc_idx2 payload1 payload2 #t1 #t2 .
    SentFrameWithIdx(sender, idx, enc_idx1, payload1) @ #t1 &
    SentFrameWithIdx(sender, idx, enc_idx2, payload2) @ #t2 &
    #t1 < #t2
    ==>
    enc_idx1 = enc_idx2   /* same idx always produces same masked form */
  "

/*
 * LEMMA 4 -- Executability
 */
lemma Executability:
  exists-trace
  "Ex sender idx enc_idx payload #t .
    SentFrameWithIdx(sender, idx, enc_idx, payload) @ #t
  "

end
