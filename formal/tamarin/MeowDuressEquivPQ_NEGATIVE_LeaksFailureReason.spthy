/*
 * NEGATIVE TEST 2: Non-Uniform Failure Observables
 *
 * This variant makes different failure modes emit DIFFERENT observables.
 * This should cause PQ_Failure_Uniform_Observable to FAIL because
 * an attacker can distinguish WHY authentication failed.
 *
 * Expected: PQ_Failure_Uniform_Observable should FAIL
 * Expected: Attacker learns reject reason from observable
 *
 * This test verifies that our positive model correctly hides failure reasons.
 */

theory MeowDuressEquivPQ_NEGATIVE_LeaksFailureReason
begin

builtins: symmetric-encryption, hashing, diffie-hellman

functions:
  kdf/3, hmac/2, duress_hash/2, frame_mac/3,
  fountain_enc/2, fountain_dec/2,
  kem_keygen_pk/1, kem_encap_ct/2, kem_encap_ss/2, kem_decap/2,
  hkdf_hybrid/2, hkdf_expand/2,
  fst/1, snd/1, meow4/0, meow3/0, true/0, false/0

equations:
  fst(<x,y>) = x,
  snd(<x,y>) = y,
  fountain_dec(fountain_enc(m, c), c) = m,
  kem_decap(sk, kem_encap_ct(kem_keygen_pk(sk), coins))
      = kem_encap_ss(kem_keygen_pk(sk), coins)

rule Setup_PQ:
    let
      salt       = ~salt
      real_key   = kdf(~pw_real,   salt, 'argon2')
      duress_key = kdf(~pw_duress, salt, 'argon2')
      d_hash     = duress_hash(~pw_duress, salt)
      kem_pk     = kem_keygen_pk(~kem_sk)
      x25519_pk  = 'g'^~x25519_sk
    in
    [ Fr(~pw_real), Fr(~pw_duress), Fr(~salt),
      Fr(~real_secret), Fr(~decoy_data),
      Fr(~kem_sk), Fr(~x25519_sk) ]
  --[ Setup_PQ($session)
    , RealPassword(~pw_real)
    , DuressPassword(~pw_duress)
    , RealSecret(~real_secret)
    ]->
    [ !SessionPQ($session, salt, real_key, duress_key, d_hash,
                 ~kem_sk, kem_pk, ~x25519_sk, x25519_pk)
    , !RealDataPQ($session, ~real_secret)
    , !DecoyDataPQ($session, ~decoy_data)
    ]

rule Encode_PQ:
    let
      kem_ct = kem_encap_ct(kem_pk, ~kem_coins)
      kem_ss = kem_encap_ss(kem_pk, ~kem_coins)
      eph_pk  = 'g'^~eph_sk
      x25519_ss = x25519_pk^~eph_sk
      hybrid_ss   = hkdf_hybrid(x25519_ss, kem_ss)
      combined_key = hkdf_expand(real_key, hybrid_ss)
      ciphertext = senc(real_secret, combined_key)
      manifest = <meow4(), salt, d_hash,
                  hmac(combined_key, <ciphertext, kem_ct, eph_pk>),
                  kem_ct, eph_pk>
      droplets = fountain_enc(<manifest, ciphertext>, 'config')
    in
    [ !SessionPQ(session, salt, real_key, duress_key, d_hash,
                 kem_sk, kem_pk, x25519_sk, x25519_pk)
    , !RealDataPQ(session, real_secret)
    , Fr(~kem_coins), Fr(~eph_sk) ]
  --[ Encoded_PQ(session, 'real') ]->
    [ TransmissionPQ(session, droplets, salt, real_key, duress_key,
                     d_hash, kem_sk, x25519_sk, real_secret,
                     kem_ct, eph_pk) ]

rule Decode_PQ_Init:
    [ TransmissionPQ(session, droplets, salt, real_key, duress_key,
                     d_hash, kem_sk, x25519_sk, real_secret,
                     kem_ct, eph_pk)
    , In(pw_attempt) ]
  --[ DecodeAttempt_PQ(session, pw_attempt) ]->
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt) ]

rule Decode_PQ_Real:
    let
      derived_key = kdf(pw_attempt, salt, 'argon2')
      kem_ss = kem_decap(kem_sk, kem_ct)
      x25519_ss = eph_pk^x25519_sk
      hybrid_ss   = hkdf_hybrid(x25519_ss, kem_ss)
      combined_key = hkdf_expand(derived_key, hybrid_ss)
    in
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt)
    , !DecoyDataPQ(session, decoy) ]
  --[ Eq(derived_key, real_key)
    , DecodedReal_PQ(session) ]->
    [ Out( diff(real_secret, decoy) )
    , DecodedStatePQ(session, 'real') ]

rule Decode_PQ_Duress:
    let
      derived_key  = kdf(pw_attempt, salt, 'argon2')
      computed_dh  = duress_hash(pw_attempt, salt)
    in
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt)
    , !DecoyDataPQ(session, decoy) ]
  --[ Eq(computed_dh, d_hash)
    , DuressTriggered_PQ(session) ]->
    [ Out( diff(decoy, real_secret) )
    , DecodedStatePQ(session, 'duress') ]

// VULNERABILITY: Different error messages for different failures!
rule Decode_PQ_WrongPassword:
    let
      derived_key  = kdf(pw_attempt, salt, 'argon2')
      computed_dh  = duress_hash(pw_attempt, salt)
    in
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt) ]
  --[ Neq(derived_key, real_key)
    , Neq(computed_dh, d_hash)
    , Reject_PQ(session, 'wrong_password') ]->
    [ Out('error_wrong_password') ]  // <-- DIFFERENT OUTPUT

rule Decode_PQ_CorruptKEM:
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt)
    , In(corrupt_kem_ct) ]
  --[ Neq(corrupt_kem_ct, kem_ct)
    , Reject_PQ(session, 'corrupt_kem') ]->
    [ Out('error_corrupt_kem') ]     // <-- DIFFERENT OUTPUT

rule Decode_PQ_Downgrade:
    [ DecodeCheckPQ(session, droplets, salt, real_key, duress_key,
                    d_hash, kem_sk, x25519_sk, real_secret,
                    kem_ct, eph_pk, pw_attempt)
    , In(<meow3(), downgrade_payload>) ]
  --[ Reject_PQ(session, 'downgrade')
    , DowngradeBlocked(session) ]->
    [ Out('error_downgrade_blocked') ]  // <-- DIFFERENT OUTPUT

// This lemma should FAIL because observables differ
lemma PQ_Failure_Uniform_Observable:
  "All session reason #i.
    Reject_PQ(session, reason) @ i
    ==> not (Ex #j. DecodedReal_PQ(session) @ j)
      & not (Ex #j. DuressTriggered_PQ(session) @ j)"

// Sanity check: can attacker distinguish failure reasons?
lemma Attacker_Distinguishes_Failures:
  exists-trace
  "Ex session #i #j.
    Reject_PQ(session, 'wrong_password') @ i
    & Reject_PQ(session, 'corrupt_kem') @ j
    & not (#i = #j)"

restriction Eq:
  "All x y #i. Eq(x, y) @ i ==> x = y"

restriction Neq:
  "All x y #i. Neq(x, y) @ i ==> not (x = y)"

end
