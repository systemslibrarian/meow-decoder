/*
 * Tamarin Proof: Secure Memory Allocation with Guard Pages
 *
 * Models the security properties of GuardedBuffer:
 * - Guard page protection prevents heap overflow/underflow
 * - Memory locking prevents swap leaks
 * - Automatic zeroization on deallocation
 * - Use-after-free detection
 *
 * Attacker model (Dolev-Yao extended):
 * - Can attempt buffer overflow/underflow (writes beyond bounds)
 * - Can attempt to read deallocated memory
 * - Can attempt to read from swap space
 * - Cannot bypass hardware memory protection (PROT_NONE / PAGE_NOACCESS)
 *
 * Author: Meow Decoder Project
 * Date: February 2026
 */
theory SecureAllocGuardPages
begin

builtins: hashing, symmetric-encryption

/*
 * ===========================================================================
 * Functions
 * ===========================================================================
 */

functions:
    guard_page/0,           /* Inaccessible guard page marker */
    alloc/2,                /* alloc(size, data) -- allocate guarded buffer */
    zero/1,                 /* zero(buf) -- securely zeroize buffer */
    mlock/1,                /* mlock(buf) -- pin in RAM */
    munlock/1,              /* munlock(buf) -- unpin from RAM */
    read_buf/2,             /* read_buf(buf, offset) -- read from buffer */
    write_buf/3,            /* write_buf(buf, offset, data) -- write to buffer */
    overflow_attempt/2,     /* overflow_attempt(buf, data) -- out-of-bounds write */
    underflow_attempt/2,    /* underflow_attempt(buf, data) -- before-bounds write */
    swap_page/1,            /* swap_page(buf) -- page swapped to disk */
    freed_marker/0          /* Marks deallocated memory */

equations:
    /* Reading a buffer returns the data at that offset */
    read_buf(write_buf(alloc(size, data), offset, newdata), offset) = newdata

/*
 * ===========================================================================
 * Rules
 * ===========================================================================
 */

/* Allocate a new guarded buffer with guard pages */
rule AllocGuardedBuffer:
    [ Fr(~buf_id), Fr(~secret) ]
  --[ Allocated(~buf_id),
      HasGuardPages(~buf_id),
      BufferContains(~buf_id, ~secret) ]->
    [ !GuardedBuffer(~buf_id, ~secret),
      !GuardPage(~buf_id, 'lower'),
      !GuardPage(~buf_id, 'upper'),
      LockedBuffer(~buf_id) ]

/* Write secret data into the buffer (within bounds) */
rule WriteBuffer:
    [ !GuardedBuffer(buf_id, old_data), Fr(~new_secret) ]
  --[ Write(buf_id, ~new_secret),
      BufferContains(buf_id, ~new_secret) ]->
    [ !GuardedBuffer(buf_id, ~new_secret) ]

/* Read from the buffer (within bounds) -- returns data to reader */
rule ReadBuffer:
    [ !GuardedBuffer(buf_id, data) ]
  --[ Read(buf_id, data) ]->
    [ !GuardedBuffer(buf_id, data) ]

/* Attacker attempts buffer overflow (write past upper guard page) */
rule AttackerOverflow:
    [ !GuardedBuffer(buf_id, data),
      !GuardPage(buf_id, 'upper'),
      In(evil_data) ]
  --[ OverflowBlocked(buf_id),
      GuardPageTriggered(buf_id, 'upper') ]->
    [ /* Guard page traps -- no state change, data protected */ ]

/* Attacker attempts buffer underflow (write before lower guard page) */
rule AttackerUnderflow:
    [ !GuardedBuffer(buf_id, data),
      !GuardPage(buf_id, 'lower'),
      In(evil_data) ]
  --[ UnderflowBlocked(buf_id),
      GuardPageTriggered(buf_id, 'lower') ]->
    [ /* Guard page traps -- no state change, data protected */ ]

/* Secure deallocation: zeroize, unlock, free */
rule DeallocGuardedBuffer:
    [ !GuardedBuffer(buf_id, data),
      LockedBuffer(buf_id) ]
  --[ Deallocated(buf_id),
      Zeroized(buf_id),
      DataDestroyed(buf_id, data) ]->
    [ FreedBuffer(buf_id) ]

/* Attacker attempts use-after-free read */
rule AttackerReadAfterFree:
    [ FreedBuffer(buf_id) ]
  --[ UseAfterFreeBlocked(buf_id) ]->
    [ FreedBuffer(buf_id)
      /* Attacker gets freed_marker, NOT the original secret */ ]

/* Memory is locked -- swap page attempt fails */
rule SwapAttemptBlocked:
    [ LockedBuffer(buf_id) ]
  --[ SwapBlocked(buf_id) ]->
    [ LockedBuffer(buf_id) ]

/*
 * ===========================================================================
 * Security Lemmas
 * ===========================================================================
 */

/* Lemma 1: Guard pages always exist for allocated buffers */
lemma guard_pages_present:
    "All buf_id #i. Allocated(buf_id) @ i
        ==> (Ex #j. HasGuardPages(buf_id) @ j & j = i)"

/* Lemma 2: Overflow is always blocked by guard pages */
lemma overflow_always_blocked:
    "All buf_id #i. OverflowBlocked(buf_id) @ i
        ==> (Ex #j. GuardPageTriggered(buf_id, 'upper') @ j & j = i)"

/* Lemma 3: Underflow is always blocked by guard pages */
lemma underflow_always_blocked:
    "All buf_id #i. UnderflowBlocked(buf_id) @ i
        ==> (Ex #j. GuardPageTriggered(buf_id, 'lower') @ j & j = i)"

/* Lemma 4: Deallocation always zeroizes data */
lemma dealloc_implies_zeroize:
    "All buf_id #i. Deallocated(buf_id) @ i
        ==> (Ex #j. Zeroized(buf_id) @ j & j = i)"

/* Lemma 5: After zeroization, secret data is destroyed */
lemma zeroized_data_irrecoverable:
    "All buf_id data #i #j. DataDestroyed(buf_id, data) @ i
        & Read(buf_id, data) @ j
        ==> j < i"

/* Lemma 6: Use-after-free never reveals original secret.
   The attacker cannot obtain the original buffer contents after dealloc. */
lemma no_use_after_free_leak:
    "All buf_id #i #j. UseAfterFreeBlocked(buf_id) @ i
        & Deallocated(buf_id) @ j
        ==> j < i"

/* Lemma 7: Locked buffers cannot be swapped to disk */
lemma locked_prevents_swap:
    "All buf_id #i. SwapBlocked(buf_id) @ i
        ==> (Ex #j. Allocated(buf_id) @ j & j < i)"

/* Lemma 8: Attacker never learns buffer secret through overflow/underflow.
   This is the main secrecy property. */
lemma secret_never_leaked_via_bounds:
    "not (Ex buf_id data #i #j.
        BufferContains(buf_id, data) @ i
        & (OverflowBlocked(buf_id) @ j | UnderflowBlocked(buf_id) @ j)
        & K(data) @ j)"

end
