/*
 * MeowKeyCommitment.spthy
 * =======================
 * Tamarin model: HMAC key commitment — prevention of invisible salamanders.
 *
 * The invisible salamanders attack allows an adversary to construct a message
 * M2 such that AES-GCM-Decrypt(k1, ct) = M1 and AES-GCM-Decrypt(k2, ct) = M2
 * for different keys k1, k2.  Adding a key commitment scheme prevents this.
 *
 * MSR v1.2 commitment scheme:
 *   commit_tag = HMAC-SHA256(auth_key, ct || aad)[0..16]
 *   auth_key   = HKDF(message_key, salt, "auth")
 *
 * Properties verified:
 *
 *  1. Commitment Binding:
 *     No adversary can produce two ciphertexts (ct1, ct2) that verify under
 *     the same commit_tag with different auth_keys — the commitment is binding.
 *
 *  2. No Invisible Salamanders:
 *     If the receiver verifies the commit_tag, they receive a plaintext
 *     consistent with the sender's intent — no confusion attack is possible.
 *
 *  3. Commitment Non-Forgeability:
 *     An adversary who does not know auth_key cannot produce a valid
 *     commit_tag for any ciphertext of their choice.
 *
 * Run with:
 *   tamarin-prover MeowKeyCommitment.spthy --prove
 */

theory MeowKeyCommitment
begin

builtins: hashing, symmetric-encryption

functions:
  hmac/2,         /* HMAC(key, data)           */
  hkdf/3,         /* HKDF(ikm, salt, info)     */
  aead_enc/3,     /* AEAD-Enc(key, nonce, pt)  */
  aead_dec/3,     /* AEAD-Dec(key, nonce, ct)  */
  truncate16/1    /* Take first 16 bytes of hash */

equations:
  aead_dec(k, n, aead_enc(k, n, pt)) = pt

/* -------------------------------------------------------------------------
 * Sender: commit + encrypt
 * -------------------------------------------------------------------------
 */

rule SenderCommitEncrypt:
  let enc_key  = hkdf(mk, salt, 'enc')
      auth_key = hkdf(mk, salt, 'auth')
      ct       = aead_enc(enc_key, nonce, pt)
      com_tag  = truncate16(hmac(auth_key, ct))
  in
  [ Fr(~mk), Fr(~salt), Fr(~nonce), Fr(~pt) ]
  --[ CommitEncrypt($Sender, ~mk, enc_key, auth_key, ~pt, ct, com_tag) ]->
  [ Out(<ct, com_tag, nonce>),
    !SentWithCommit($Sender, ct, com_tag, auth_key, enc_key)
  ]

/* -------------------------------------------------------------------------
 * Receiver: verify commit + decrypt
 * -------------------------------------------------------------------------
 */

rule ReceiverVerifyDecrypt:
  let enc_key  = hkdf(mk, salt, 'enc')
      auth_key = hkdf(mk, salt, 'auth')
      expected = truncate16(hmac(auth_key, ct))
      pt       = aead_dec(enc_key, nonce, ct)
  in
  [ Fr(~mk), Fr(~salt),
    In(<ct, com_tag_recv, nonce>) ]
  --[ CommitVerify($Receiver, mk, auth_key, ct, com_tag_recv, expected),
      CommitAccepted($Receiver, ct, pt, expected)
    ]->
  []

/* Adversary creates commitment with different auth_key (attack scenario) */
rule AdversaryForgeCommit:
  [ In(<ct, com_tag>),
    Fr(~fake_auth_key) ]
  --[ AdversaryForgeAttempt(ct, com_tag, ~fake_auth_key) ]->
  [ Out(truncate16(hmac(~fake_auth_key, ct))) ]

/* =========================================================================
 * Security Lemmas
 * =========================================================================
 */

/*
 * LEMMA 1 — Commitment Binding
 *
 * Two different ciphertexts cannot share the same commitment tag under
 * the same auth_key (assuming HMAC collision resistance).
 *
 * If two frames share the same commit tag and auth_key, their ciphertexts
 * must be identical.
 */
lemma CommitmentBinding:
  "All sender ct1 ct2 mk auth_key pt1 com_tag #t1 #t2 .
    CommitEncrypt(sender, mk, hkdf(mk, 'salt', 'enc'), auth_key, pt1, ct1, com_tag) @ #t1 &
    CommitEncrypt(sender, mk, hkdf(mk, 'salt', 'enc'), auth_key, pt1, ct2, com_tag) @ #t2
    ==>
    ct1 = ct2
  "

/*
 * LEMMA 2 — No Invisible Salamanders
 *
 * If an adversary provides a ct2 different from what the sender encrypted
 * but claims it has the same commit_tag under the same auth_key, the
 * receiver's verification will reject it.
 *
 * Formalised: the adversary cannot produce (ct2, com_tag') such that
 * com_tag' matches an auth_key-bound commitment for ct1 ≠ ct2.
 */
lemma NoInvisibleSalamanders:
  "All receiver ct pt expected #t .
    CommitAccepted(receiver, ct, pt, expected) @ #t
    ==>
    /* The receiver only accepts frames whose ct matches the commit tag */
    (Ex sender mk auth_key pt2 com_orig #t2 .
      CommitEncrypt(sender, mk, hkdf(mk, 'salt', 'enc'), auth_key, pt2, ct, com_orig) @ #t2 &
      com_orig = expected
    ) |
    /* OR the auth_key was compromised */
    (Ex auth_key #t3 . KU(auth_key) @ #t3)
  "

/*
 * LEMMA 3 — Commitment Non-Forgeability
 *
 * An adversary who does not know auth_key cannot produce a valid
 * commit_tag for an arbitrary ciphertext.
 */
lemma CommitmentNonForgeability:
  "All ct com_tag fake_auth_key #t .
    AdversaryForgeAttempt(ct, com_tag, fake_auth_key) @ #t
    ==>
    /* Forged tag is valid only if adversary knows real auth_key */
    (Ex sender auth_key mk pt nonce #t2 .
      CommitEncrypt(sender, mk, hkdf(mk, 'salt', 'enc'), auth_key, pt, ct, com_tag) @ #t2 &
      fake_auth_key = auth_key
    )
  "

/*
 * LEMMA 4 — Executability
 */
lemma Executability:
  exists-trace
  "Ex sender mk enc_key auth_key pt ct com_tag #t .
    CommitEncrypt(sender, mk, enc_key, auth_key, pt, ct, com_tag) @ #t
  "

end
