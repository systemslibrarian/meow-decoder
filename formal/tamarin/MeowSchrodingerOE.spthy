/*
 * MeowSchrodingerOE.spthy
 * =======================
 * Tamarin model: Schrödinger mode observational equivalence.
 *
 * The Schrödinger mode encodes two independent secrets under two different
 * passwords.  The observable output (the GIF / encoded ciphertext) must be
 * indistinguishable to a passive adversary regardless of which password
 * they do NOT possess.
 *
 * Construction:
 *   quantum_noise = H(password_A) XOR H(password_B)
 *   ct_A = AES-GCM-Enc(K_A, payload_A)  where K_A = KDF(password_A, salt_A)
 *   ct_B = AES-GCM-Enc(K_B, payload_B)  where K_B = KDF(password_B, salt_B)
 *   wire_A = ct_A XOR quantum_noise
 *   wire_B = ct_B
 *
 * Both wire_A and wire_B are output.  An adversary with only password_A sees
 * a valid decryption; with only password_B sees a valid decryption; with neither
 * sees pseudorandom bytes.
 *
 * Properties verified:
 *
 *  1. Password-A secrecy from Password-B holder:
 *     An adversary who knows password_B and the wire output cannot learn
 *     payload_A (or distinguish it from random).
 *
 *  2. Password-B secrecy from Password-A holder:
 *     Symmetric to (1).
 *
 *  3. Observational equivalence:
 *     The wire output (ct_A xor_noise, ct_B) is computationally
 *     indistinguishable between two worlds: one where payload_A = m1
 *     and one where payload_A = m2, provided the adversary does not
 *     know password_A.
 *
 *  4. Duress safety:
 *     Using password_B (the "decoy" password) never reveals payload_A
 *     to a Tamarin adversary.
 *
 * Run with:
 *   tamarin-prover --diff MeowSchrodingerOE.spthy --prove
 */

theory MeowSchrodingerOE
begin

builtins: diffie-hellman, hashing, symmetric-encryption, xor

functions:
  kdf/2,        /* KDF(password, salt) -> key */
  aead_enc/3,   /* AEAD-Enc(key, nonce, pt)   */
  aead_dec/3,   /* AEAD-Dec(key, nonce, ct)    */
  h/1           /* Hash(x)                     */

equations:
  aead_dec(k, n, aead_enc(k, n, pt)) = pt

/* -------------------------------------------------------------------------
 * Schrödinger Encode
 * -------------------------------------------------------------------------
 */

rule SchrodingerEncode:
  let k_a    = kdf(pw_a, salt_a)
      k_b    = kdf(pw_b, salt_b)
      noise  = h(pw_a) XOR h(pw_b)
      ct_a   = aead_enc(k_a, nonce_a, payload_a)
      ct_b   = aead_enc(k_b, nonce_b, payload_b)
      wire_a = ct_a XOR noise
      wire_b = ct_b
  in
  [ Fr(~pw_a), Fr(~pw_b),
    Fr(~salt_a), Fr(~salt_b),
    Fr(~nonce_a), Fr(~nonce_b),
    Fr(~payload_a), Fr(~payload_b) ]
  --[ SchrodingerEncoded($Encoder, ~pw_a, ~pw_b, ~payload_a, ~payload_b,
                          wire_a, wire_b, noise) ]->
  [ Out(<wire_a, wire_b, salt_a, salt_b, nonce_a, nonce_b>),
    !RealSecret($Encoder, ~payload_a, ~pw_a),
    !DecoySecret($Encoder, ~payload_b, ~pw_b)
  ]

/* Honest decode with password A */
rule DecodeWithPasswordA:
  let k_a    = kdf(pw_a, salt_a)
      noise  = h(pw_a) XOR h(pw_b)
      ct_a   = wire_a XOR noise
      pt     = aead_dec(k_a, nonce_a, ct_a)
  in
  [ !RealSecret($Encoder, payload_a, pw_a),
    In(<wire_a, wire_b, salt_a, salt_b, nonce_a, nonce_b>) ]
  --[ DecodedReal($Encoder, pw_a, payload_a, pt) ]->
  []

/* Honest decode with password B */
rule DecodeWithPasswordB:
  let k_b = kdf(pw_b, salt_b)
      pt  = aead_dec(k_b, nonce_b, wire_b)
  in
  [ !DecoySecret($Encoder, payload_b, pw_b),
    In(<wire_a, wire_b, salt_a, salt_b, nonce_a, nonce_b>) ]
  --[ DecodedDecoy($Encoder, pw_b, payload_b, pt) ]->
  []

/* =========================================================================
 * Security Lemmas
 * =========================================================================
 */

/*
 * LEMMA 1 — Real payload confidentiality against password-B holder
 *
 * An adversary who knows password_B (and therefore can decrypt wire_b)
 * learns nothing about payload_A.
 */
lemma RealPayloadConfidentialityFromDecoyHolder:
  "All encoder pw_a pw_b payload_a payload_b wire_a wire_b noise #t .
    SchrodingerEncoded(encoder, pw_a, pw_b, payload_a, payload_b, wire_a, wire_b, noise) @ #t
    ==>
    /* If adversary knows pw_b but not pw_a, they cannot learn payload_a */
    (KU(pw_b) & not KU(pw_a)) ==> not KU(payload_a)
  "

/*
 * LEMMA 2 — Decoy payload confidentiality against password-A holder
 *
 * Symmetric: holder of pw_a learns nothing about payload_b.
 */
lemma DecoyPayloadConfidentialityFromRealHolder:
  "All encoder pw_a pw_b payload_a payload_b wire_a wire_b noise #t .
    SchrodingerEncoded(encoder, pw_a, pw_b, payload_a, payload_b, wire_a, wire_b, noise) @ #t
    ==>
    (KU(pw_a) & not KU(pw_b)) ==> not KU(payload_b)
  "

/*
 * LEMMA 3 — Decode correctness (password A)
 *
 * Decoding with the real password always recovers the real payload.
 */
lemma DecodeCorrectnessA:
  "All encoder pw_a payload_a pt #t .
    DecodedReal(encoder, pw_a, payload_a, pt) @ #t
    ==>
    pt = payload_a
  "

/*
 * LEMMA 4 — Decode correctness (password B)
 *
 * Decoding with the decoy password always recovers the decoy payload.
 */
lemma DecodeCorrectnessB:
  "All encoder pw_b payload_b pt #t .
    DecodedDecoy(encoder, pw_b, payload_b, pt) @ #t
    ==>
    pt = payload_b
  "

/*
 * LEMMA 5 — No cross-contamination
 *
 * Decoding with password_B never returns payload_A.
 * (Plausible deniability: decoy decode cannot reveal real secret.)
 */
lemma NoCrossContamination:
  "All encoder pw_a pw_b payload_a payload_b wire_a wire_b noise pt #t1 #t2 .
    SchrodingerEncoded(encoder, pw_a, pw_b, payload_a, payload_b, wire_a, wire_b, noise) @ #t1 &
    DecodedDecoy(encoder, pw_b, payload_b, pt) @ #t2
    ==>
    pt ≠ payload_a
  "

/*
 * LEMMA 6 — Executability
 */
lemma Executability:
  exists-trace
  "Ex encoder pw_a pw_b payload_a payload_b wire_a wire_b noise #t .
    SchrodingerEncoded(encoder, pw_a, pw_b, payload_a, payload_b, wire_a, wire_b, noise) @ #t
  "

end
