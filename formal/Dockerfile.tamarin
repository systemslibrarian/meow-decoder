# Formal Verification Docker Image — Tamarin Prover
# Used by `make formal-tamarin-docker` for CI environments where
# native Tamarin is unavailable (e.g., Alpine Linux / musl libc).
#
# Tamarin requires Maude, which is only available on glibc systems.
# This container provides a Debian-based environment with both installed.
#
# Note: tamarin-prover is NOT in Debian Bookworm's standard repos.
# We install the pre-built binary from the official GitHub release.

FROM debian:bookworm-slim

# Install runtime dependencies for Tamarin (Maude, GraphViz, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    maude \
    graphviz \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Tamarin from official GitHub release binary
# Using v1.10.0 — latest stable (1.8.1 never existed; went 1.8.0 → 1.10.0)
RUN curl -sL -o /tmp/tamarin.tar.gz \
      "https://github.com/tamarin-prover/tamarin-prover/releases/download/1.10.0/tamarin-prover-1.10.0-linux64-ubuntu.tar.gz" \
    && tar xzf /tmp/tamarin.tar.gz -C /usr/local/bin/ \
    && chmod +x /usr/local/bin/tamarin-prover \
    && rm /tmp/tamarin.tar.gz \
    && tamarin-prover --help > /dev/null 2>&1 || echo "Tamarin installed (help check may fail without maude)"

WORKDIR /formal

# Copy only the Tamarin models
COPY formal/tamarin/ /formal/tamarin/

# Default: run MEOW3 duress OE, then MEOW4/MEOW5 PQ duress OE
CMD ["bash", "-c", \
    "tamarin-prover --diff /formal/tamarin/MeowDuressEquiv.spthy --prove && \
     tamarin-prover --diff /formal/tamarin/MeowDuressEquivPQ.spthy --prove"]
