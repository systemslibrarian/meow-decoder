# Formal Verification Docker Image — Tamarin Prover
# Used by `make formal-tamarin-docker` for CI environments where
# native Tamarin is unavailable (e.g., Alpine Linux / musl libc).
#
# Tamarin requires Maude, which is only available on glibc systems.
# This container provides a Debian-based environment with both installed.
#
# Note: tamarin-prover is NOT in Debian Bookworm's standard repos.
# We install the pre-built binary from the official GitHub release.

FROM debian:bookworm-slim

# Install runtime dependencies for Tamarin (GraphViz, etc.)
# Note: Debian bookworm ships Maude 3.2, which Tamarin does NOT support
# (requires 3.2.1+). We install Maude 3.5.1 from the official release instead.
RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz \
    ca-certificates \
    curl \
    libgmp10 \
    libncurses6 \
    libtinfo6 \
    && rm -rf /var/lib/apt/lists/*

# Install Maude 3.5.1 from official release (Tamarin-compatible, supports 3.5)
# Repo moved from SRI-CSL/Maude to maude-lang/Maude.
RUN curl -sL -o /tmp/maude.zip \
      "https://github.com/maude-lang/Maude/releases/download/Maude3.5.1/Maude-3.5.1-linux-x86_64.zip" \
    && apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/* \
    && unzip -q /tmp/maude.zip -d /opt/maude \
    && MAUDE_BIN=$(find /opt/maude -name 'maude.linux64' -o -name 'maude' -type f | head -1) \
    && if [ -z "$MAUDE_BIN" ]; then find /opt/maude -type f && echo "ERROR: maude binary not found" && exit 1; fi \
    && MAUDE_DIR=$(dirname "$MAUDE_BIN") \
    && cp "$MAUDE_BIN" /usr/local/bin/maude \
    && chmod +x /usr/local/bin/maude \
    && mkdir -p /usr/local/share/maude \
    && cp "$MAUDE_DIR/"*.maude /usr/local/share/maude/ 2>/dev/null || true \
    && rm /tmp/maude.zip

# Maude needs MAUDE_LIB to find its prelude files
ENV MAUDE_LIB=/usr/local/share/maude

# Tamarin's Haskell runtime requires a UTF-8 locale to read .spthy files
# containing non-ASCII characters (em dashes, math symbols in comments).
# Without this, hGetContents raises "invalid argument (cannot decode byte
# sequence starting from ...)" on UTF-8 multi-byte characters.
RUN apt-get update && apt-get install -y --no-install-recommends locales \
    && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install Tamarin from official GitHub release binary
# Using v1.10.0 — latest stable (1.8.1 never existed; went 1.8.0 → 1.10.0)
RUN curl -sL -o /tmp/tamarin.tar.gz \
      "https://github.com/tamarin-prover/tamarin-prover/releases/download/1.10.0/tamarin-prover-1.10.0-linux64-ubuntu.tar.gz" \
    && tar xzf /tmp/tamarin.tar.gz -C /usr/local/bin/ \
    && chmod +x /usr/local/bin/tamarin-prover \
    && rm /tmp/tamarin.tar.gz \
    && tamarin-prover --help > /dev/null 2>&1 || echo "Tamarin installed (help check may fail without maude)"

WORKDIR /formal

# Copy only the Tamarin models
COPY formal/tamarin/ /formal/tamarin/

# Default: run MEOW3 duress OE, then MEOW4/MEOW5 PQ duress OE
CMD ["sh", "-c", \
    "tamarin-prover --diff /formal/tamarin/MeowDuressEquiv.spthy --prove && \
     tamarin-prover --diff /formal/tamarin/MeowDuressEquivPQ.spthy --prove"]
