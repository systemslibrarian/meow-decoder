*.xcarchive
*.dSYM.zip

# Signing material — must NEVER be committed; CI gets these from Actions secrets.
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
*.p8
ExportOptions.plist

# Editor / OS detritus
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Throwaway base64 dumps from cert prep
abc

# bootstrap-apple.py output — contains the Distribution private key and .p12.
