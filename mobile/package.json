{
  "name": "meow-decoder-mobile",
  "version": "3.2.0",
  "description": "Optical air-gap QR capture app for meow-decoder",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --device",
    "start": "react-native start",
    "test": "jest --testPathPattern='__tests__'",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "pod-install": "cd ios && pod install && cd ..",
    "bump-version": "bash scripts/bump-version.sh"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@react-native/metro-config": "^0.84.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "react": "18.2.0",
    "react-native": "0.73.4",
    "react-native-biometrics": "^3.0.1",
    "react-native-document-picker": "^9.1.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.14.1",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "3.6.3",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "14.1.0",
    "react-native-vision-camera": "4.0.5",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-typescript": "^7.23.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@tsconfig/react-native": "^3.0.2",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.55",
    "@types/react-native": "^0.73.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-vision-camera|react-native-reanimated|react-native-biometrics|react-native-mmkv|react-native-sensors|react-native-svg|@react-native-clipboard)/)"
    ],
    "moduleNameMapper": {
      "react-native-vision-camera": "<rootDir>/__mocks__/react-native-vision-camera.ts",
      "react-native-biometrics": "<rootDir>/__mocks__/react-native-biometrics.ts",
      "react-native-sensors": "<rootDir>/__mocks__/react-native-sensors.ts",
      "react-native-fs": "<rootDir>/__mocks__/react-native-fs.ts",
      "react-native-document-picker": "<rootDir>/__mocks__/react-native-document-picker.ts",
      "react-native-mmkv": "<rootDir>/__mocks__/react-native-mmkv.ts",
      "react-native-haptic-feedback": "<rootDir>/__mocks__/react-native-haptic-feedback.ts",
      "react-native-qrcode-svg": "<rootDir>/__mocks__/react-native-qrcode-svg.ts",
      "react-native-svg": "<rootDir>/__mocks__/react-native-svg.ts",
      "@react-native-clipboard/clipboard": "<rootDir>/__mocks__/@react-native-clipboard/clipboard.ts"
    }
  }
}
