<!--
  Adaptive icon foreground: uses the meow-decoder no-tagline logo PNG.
  Background colour (#0a0a0f) is set in ic_launcher.xml / ic_launcher_background.
  The bitmap is inset to stay within the adaptive icon safe zone (72×72 dp
  within a 108×108 dp canvas — ~17% inset each side).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="14dp"
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp">
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center"
            android:tileMode="disabled"/>
    </item>
</layer-list>
