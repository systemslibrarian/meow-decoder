<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — MeowCapture mobile companion app

  SECURITY: Camera-only permissions.
  - NO android.permission.INTERNET (air-gap enforced at the platform level)
  - NO android.permission.ACCESS_FINE_LOCATION
  - NO android.permission.RECORD_AUDIO
  - NO android.permission.READ_EXTERNAL_STORAGE (not needed; uses WRITE_EXTERNAL_STORAGE for downloads only)

  The absence of INTERNET permission makes it impossible for the app to exfiltrate
  captured frames to a remote server. This is a hard constraint of the threat model.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera access required for scanning GIF QR codes -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Write to Downloads folder (export JSON output) — revoked on Android 10+ via scoped storage -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Vibration for haptic feedback on successful scan milestones -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric authentication for export gate (Face/Fingerprint/Device credential) -->
    <!-- react-native-biometrics may declare this via manifest merger, but we
         list it explicitly for audit clarity and documentation. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Camera hardware feature declaration -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link URL scheme: meow://capture?session_id=...&expected_frames=... -->
            <!-- android:autoVerify="false" ensures no App Link verification is attempted -->
            <!-- (this app never runs a domain verification server; it is intentionally offline) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="meow" />
            </intent-filter>
        </activity>
    </application>

</manifest>
