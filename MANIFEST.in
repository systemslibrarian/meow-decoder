# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include THREAT_MODEL.md
include ARCHITECTURE.md
include MANIFEST_VERSIONING.md

# Include assets
recursive-include assets *.svg *.png
recursive-include sounds *.wav

# Include examples
recursive-include examples *.py *.md

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp

# archive/ is a top-level reference directory, not part of the package —
# setuptools `packages.find` (pyproject.toml) only includes `meow_decoder*`
# so it would not be packaged anyway, but make the intent explicit.
prune archive
