# .coveragerc-security
# Enforces coverage ONLY on the true security-critical modules.
# Use this in CI to gate merges / releases — do NOT apply to the full codebase.
#
# Recommended CI usage:
#   coverage run -m pytest
#   coverage report --rcfile=.coveragerc-security --fail-under=52
#   coverage xml --rcfile=.coveragerc-security -o coverage.xml
#
# or with pytest-cov:
#   pytest --cov-config=.coveragerc-security --cov-fail-under=52 --cov-report=xml

[run]
source =
    meow_decoder/constant_time.py
    meow_decoder/frame_mac.py
    meow_decoder/crypto_backend.py
    meow_decoder/crypto.py
    meow_decoder/forward_secrecy.py
    meow_decoder/x25519_forward_secrecy.py
    meow_decoder/double_ratchet.py
    meow_decoder/metadata_obfuscation.py
    meow_decoder/secure_cleanup.py
    meow_decoder/pq_hybrid.py
    meow_decoder/pq_crypto_real.py
    meow_decoder/pq_signatures.py
    meow_decoder/duress_mode.py
    meow_decoder/stego_advanced.py
    meow_decoder/timelock_duress.py

branch = true

[report]
exclude_also =
    pragma: no cover
    if __name__ == .__main__.:
    def main\(.*\):
    raise NotImplementedError
    raise AssertionError
    if TYPE_CHECKING:
    if _TEST_MODE:
    \.\.\.
    if 0:
    if False:

show_missing = True
sort = Miss

fail_under = 52

[xml]
output = coverage.xml