# .coveragerc-security
# Only the true security-critical modules — enforce meaningful coverage here

[run]
source =
    meow_decoder/constant_time.py
    meow_decoder/frame_mac.py
    meow_decoder/crypto_backend.py
    meow_decoder/crypto.py
    meow_decoder/forward_secrecy.py
    meow_decoder/x25519_forward_secrecy.py
    meow_decoder/double_ratchet.py
    meow_decoder/metadata_obfuscation.py
    meow_decoder/secure_cleanup.py
    meow_decoder/pq_hybrid.py
    meow_decoder/pq_crypto_real.py
    meow_decoder/pq_signatures.py
    # ──────────────────────────────────────────────
    # Strongly consider adding these too (deniability cluster):
    meow_decoder/duress_mode.py
    meow_decoder/stego_advanced.py
    meow_decoder/timelock_duress.py
    # meow_decoder/crypto_enhanced.py     # ← only if it has real security logic

branch = true

[report]
exclude_also =
    pragma: no cover
    if __name__ == .__main__.:
    def main\(.*\):
    raise NotImplementedError
    raise AssertionError
    if TYPE_CHECKING:
    if _TEST_MODE:
    \.\.\.
    if 0:
    if False:

show_missing = True
sort = Miss

# Starting realistic threshold — raise gradually
fail_under = 52               # Adjust up every ~10–15% improvement 