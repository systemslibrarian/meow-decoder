# .coveragerc-security - Python security coverage gate (LOCAL-ONLY)
#
# Codecov monitors RUST coverage. This file gates Python crypto modules locally.
# Enforces coverage ONLY on the true security-critical Python modules.
#
# Recommended CI usage:
#   coverage run -m pytest
#   coverage report --rcfile=.coveragerc-security --fail-under=85
#   coverage xml --rcfile=.coveragerc-security -o coverage.xml
#
# or with pytest-cov:
#   pytest --cov-config=.coveragerc-security --cov-fail-under=85 --cov-report=xml

[run]
source =
    meow_decoder

include =
    meow_decoder/constant_time.py
    meow_decoder/frame_mac.py
    meow_decoder/crypto_backend.py
    meow_decoder/crypto.py
    meow_decoder/metadata_obfuscation.py
    meow_decoder/ratchet.py
    meow_decoder/pq_hybrid.py

branch = true

[report]
include =
    meow_decoder/constant_time.py
    meow_decoder/frame_mac.py
    meow_decoder/crypto_backend.py
    meow_decoder/crypto.py
    meow_decoder/metadata_obfuscation.py
    meow_decoder/ratchet.py
    meow_decoder/pq_hybrid.py

exclude_also =
    pragma: no cover
    if __name__ == .__main__.:
    def main\(.*\):
    raise NotImplementedError
    raise AssertionError
    if TYPE_CHECKING:
    if _TEST_MODE:
    \.\.\.
    if 0:
    if False:

show_missing = True
sort = Miss

fail_under = 85

[xml]
output = coverage.xml